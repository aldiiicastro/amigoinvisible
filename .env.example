# Solo servidor. Cargar en Vercel > Settings > Environment Variables (y en .env.local para desarrollo).
# Nunca usar el prefijo VITE_ con estas variables: se expondrían al navegador.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Clave AES-256 para cifrar quién le regala a quién (Etapa 3). Tiene que ser de 32 bytes en base64 (44 caracteres).
# Generarla UNA vez y no perderla ni cambiarla después del sorteo: sin ella no se pueden leer las asignaciones.
# Opción fácil, sin instalar nada: abrir el navegador, F12 > Consola, pegar y apretar Enter:
#   btoa(String.fromCharCode(...crypto.getRandomValues(new Uint8Array(32))))
# Con Node:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=
