# Solo servidor. Cargar en Vercel > Settings > Environment Variables (y en .env.local para desarrollo).
# Nunca usar el prefijo VITE_ con estas variables: se expondrían al navegador.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Clave AES-256 (Etapa 3 en adelante). Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=
